  {
    "text": "こんにちは",
    "file": "125aeadf27b0459b8760.mp3"
  },
  {
    "text": "こんにちは、お元気ですか。",
    "file": "2d1bad9768db80f7ddf3.mp3"
  },
  {
    "text": "おはよう",
    "file": "4314662c3426676a1dd5.mp3"
  },
  {
    "text": "おはよう、よく眠れましたか。",
    "file": "e1c1807bba27a32bae12.mp3"
  },
  {
    "text": "こんばんは",
    "file": "70d3e9fba8c749125e4f.mp3"
  },
  {
    "text": "こんばんは、今日は寒いですね。",
    "file": "9e2eb143a908b0825fd2.mp3"
  },
  {
    "text": "ありがとう",
    "file": "5773be7d3dedf7cbda8a.mp3"
  },
  {
    "text": "手伝ってくれて、ありがとう。",
    "file": "e8589aa9b5a9b0f9868b.mp3"
  },
  {
    "text": "すみません",
    "file": "20c644122287a484288c.mp3"
  },
  {
    "text": "すみません、駅はどこですか。",
    "file": "71ffed1aa18e055b9020.mp3"
  },
  {
    "text": "さようなら",
    "file": "7d91977f8227bc5a8b0e.mp3"
  },
  {
    "text": "先生、さようなら。",
    "file": "2f2663224f6fd366250f.mp3"
  },
  {
    "text": "はじめまして",
    "file": "1a7b00c2059a05e6e47c.mp3"
  },
  {
    "text": "はじめまして、田中です。",
    "file": "4aa04d04dc146f9798c2.mp3"
  },
  {
    "text": "お願いします",
    "file": "c5c3df248eaaa492712e.mp3"
  },
  {
    "text": "水をお願いします。",
    "file": "9400e97be8e8e6127252.mp3"
  },
  {
    "text": "はい",
    "file": "8f90d85ec13a0b1b12d8.mp3"
  },
  {
    "text": "はい、わかりました。",
    "file": "83356588561a699085b4.mp3"
  },
  {
    "text": "いいえ",
    "file": "48ef2b674823d03d4586.mp3"
  },
  {
    "text": "いいえ、違います。",
    "file": "9875e6531e4a8aa37ca1.mp3"
  },
  {
    "text": "私",
    "file": "dbc879e139da5b0af3c7.mp3"
  },
  {
    "text": "私は中国から来ました。",
    "file": "88d7845f33bd907d72fd.mp3"
  },
  {
    "text": "日本語",
    "file": "77710aedc74ecfa33685.mp3"
  },
  {
    "text": "日本語を勉強しています。",
    "file": "17cabce22609689656f3.mp3"
  },
  {
    "text": "学生",
    "file": "13a58ec2074e014ae64e.mp3"
  },
  {
    "text": "兄は大学生です。",
    "file": "95b3cd02c2637863d819.mp3"
  },
  {
    "text": "先生",
    "file": "cd98e43da31bb1b90dc1.mp3"
  },
  {
    "text": "先生に質問します。",
    "file": "c7aeb74e754a203a017a.mp3"
  },
  {
    "text": "友達",
    "file": "93015cdfdcb0f67afdb4.mp3"
  },
  {
    "text": "友達と映画を見ます。",
    "file": "ae1d7631926018d3a965.mp3"
  },
  {
    "text": "学校",
    "file": "dc6e2aafeb9e125b69d1.mp3"
  },
  {
    "text": "毎日、学校に行きます。",
    "file": "7186e4ffb0f68776666d.mp3"
  },
  {
    "text": "本",
    "file": "83831c3f910cf940c661.mp3"
  },
  {
    "text": "図書館で本を読みます。",
    "file": "63a60c827e2382b087bc.mp3"
  },
  {
    "text": "水",
    "file": "327b54d04f71f2126114.mp3"
  },
  {
    "text": "水を飲みます。",
    "file": "70a6096abed12ad7cc0a.mp3"
  },
  {
    "text": "猫",
    "file": "a810bf845a307382118e.mp3"
  },
  {
    "text": "猫が寝ています。",
    "file": "f622ddc8a4ea04993431.mp3"
  },
  {
    "text": "犬",
    "file": "1e82f9b0b67529c5bc8e.mp3"
  },
  {
    "text": "犬と散歩します。",
    "file": "dd4f41341259af42d742.mp3"
  },
  {
    "text": "今日",
    "file": "5c9cf5e0dd47dc80ac04.mp3"
  },
  {
    "text": "今日はいい天気です。",
    "file": "f09463ded6f05bc0a804.mp3"
  },
  {
    "text": "明日",
    "file": "6450d5f86685fd01626e.mp3"
  },
  {
    "text": "明日は休みです。",
    "file": "fcbb01dd80fe943abcc2.mp3"
  },
  {
    "text": "朝",
    "file": "419c745398dffb654b26.mp3"
  },
  {
    "text": "朝、パンを食べます。",
    "file": "099cb1a3248dd0d46ffa.mp3"
  },
  {
    "text": "食べる",
    "file": "2b7ce3887f50f5f184c4.mp3"
  },
  {
    "text": "一緒にご飯を食べましょう。",
    "file": "2f181a90810f7de9d846.mp3"
  },
  {
    "text": "飲む",
    "file": "5706ea39cdd0272c4673.mp3"
  },
  {
    "text": "毎朝、お茶を飲みます。",
    "file": "e1eac327350fcd75ec1a.mp3"
  },
  {
    "text": "行く",
    "file": "d74a571ffab4df17d50c.mp3"
  },
  {
    "text": "明日、京都に行きます。",
    "file": "a58643c4db6f81ce0ccd.mp3"
  },
  {
    "text": "見る",
    "file": "c1ee2c0cd4e9e38c42d6.mp3"
  },
  {
    "text": "夜、テレビを見ます。",
    "file": "15c3203759bf6fe5a249.mp3"
  },
  {
    "text": "聞く",
    "file": "d9291ccba400db30a740.mp3"
  },
  {
    "text": "音楽を聞きます。",
    "file": "08499b0c2f71295df73a.mp3"
  },
  {
    "text": "電車",
    "file": "92e4d1d0c7a5087ac9e5.mp3"
  },
  {
    "text": "電車で会社に行きます。",
    "file": "1cb25f6bca7d818221e0.mp3"
  },
  {
    "text": "切手",
    "file": "e4180a9b7cb78f641b77.mp3"
  },
  {
    "text": "郵便局で切手を買います。",
    "file": "140aa984fccf7ac58e2a.mp3"
  },
  {
    "text": "コーヒー",
    "file": "bb782cf87667ea09544c.mp3"
  },
  {
    "text": "コーヒーを一杯ください。",
    "file": "f9ef78595c58fd507eaf.mp3"
  },
  {
    "text": "スーパー",
    "file": "ec8fb05b2123de8c0305.mp3"
  },
  {
    "text": "スーパーで野菜を買います。",
    "file": "f5faca22abc3622f58ea.mp3"
  },
  {
    "text": "テレビ",
    "file": "6ff4e9d438f1170b486b.mp3"
  },
  {
    "text": "このテレビは新しいです。",
    "file": "83346ed8bfcb433b475c.mp3"
  },
  {
    "text": "カメラ",
    "file": "8ed84c233a439cf93500.mp3"
  },
  {
    "text": "カメラで写真を撮ります。",
    "file": "c11a4ac194fd38c18a7c.mp3"
  },
  {
    "text": "ホテル",
    "file": "b9c4eb36513280fbeaa3.mp3"
  },
  {
    "text": "駅の近くにホテルがあります。",
    "file": "c2cbc2fa1d56958168d8.mp3"
  },
  {
    "text": "タクシー",
    "file": "88e568182d22511934d0.mp3"
  },
  {
    "text": "タクシーで帰ります。",
    "file": "b605e9166b2f96bf2d37.mp3"
  },
  {
    "text": "パン",
    "file": "433c68371a3d55886bbd.mp3"
  },
  {
    "text": "このパンはおいしいです。",
    "file": "b65928f571a5dc11763f.mp3"
  },
  {
    "text": "ベッド",
    "file": "510c20b4dc9d5ac41aba.mp3"
  },
  {
    "text": "部屋にベッドがあります。",
    "file": "ac5c9cb8a0b69dcecff5.mp3"
  },
  {
    "text": "チケット",
    "file": "cc3f6965e496b7343cbe.mp3"
  },
  {
    "text": "チケットを二枚ください。",
    "file": "985a235f2875c9fb185b.mp3"
  },
  {
    "text": "コンピューター",
    "file": "64e9d32b2032f7a98c1a.mp3"
  },
  {
    "text": "コンピューターで仕事をします。",
    "file": "1a30791170c4b7bd2f57.mp3"
  },
  {
    "text": "はじめまして。",
    "file": "842fbbbd1e4932506ea2.mp3"
  },
  {
    "text": "私は学生です。",
    "file": "672ded26ea3a72ec940b.mp3"
  },
  {
    "text": "毎日、日本語を勉強します。",
    "file": "266fffb715cf17ceb38d.mp3"
  },
  {
    "text": "どうぞよろしくお願いします。",
    "file": "f314a3ca872805d6b85a.mp3"
  },
  {
    "text": "今日は日曜日です。",
    "file": "8013d761055640612577.mp3"
  },
  {
    "text": "友達と公園に行きます。",
    "file": "df5a3bf83b72b654009a.mp3"
  },
  {
    "text": "一緒にお弁当を食べます。",
    "file": "cb2734bad6a60e856551.mp3"
  },
  {
    "text": "とても楽しいです。",
    "file": "7a2efe51e50cad23a5aa.mp3"
  }
]
